# OpenAI API Configuration
# Copy this file to .env and fill in your values

# API Key for OpenAI or compatible provider
OPENAI_API_KEY=sk-your-api-key-here

# Base URL for API (optional, defaults to https://api.openai.com/v1)
# For OpenAI: leave empty or use https://api.openai.com/v1
# For compatible providers: use their base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name to use (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
